{
  "name": "jiggle-app-status",
  "version": "1.0.0",
  "private": true,
  "description": "Out-of-band app status (force-upgrade + maintenance) served via EAS Hosting",
  "main": "expo-router/entry",
  "scripts": {
    "sync-public": "mkdir -p public && cp status.json public/status.json && cp status.preview.json public/status.preview.json",
    "prestart": "npm run sync-public",
    "start": "expo start",
    "preexport": "npm run sync-public",
    "export": "expo export --platform web",
    "deploy": "npx eas-cli deploy",
    "deploy:prod": "npm run export && npx eas-cli deploy --prod"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.7",
    "expo-modules-core": "~2.5.0",
    "expo-router": "~5.0.0",
    "expo-status-bar": "~2.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "eas-cli": "^21.0.2",
    "typescript": "~5.8.3"
  }
}
